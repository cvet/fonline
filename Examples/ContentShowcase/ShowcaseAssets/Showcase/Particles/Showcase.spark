<SPARK>
  <System name="ShowcaseParticle">
    <attrib id="groups">
      <Group name="ShowcaseSparks">
        <attrib id="capacity" value="32" />
        <attrib id="life time" value="0.9;1.4" />
        <attrib id="emitters">
          <StaticEmitter>
            <attrib id="tank" value="-1" />
            <attrib id="flow" value="12" />
            <attrib id="force" value="8;14" />
            <attrib id="zone">
              <Sphere>
                <attrib id="position" value="(0,0,0)" />
                <attrib id="radius" value="3" />
              </Sphere>
            </attrib>
            <attrib id="full" value="false" />
          </StaticEmitter>
        </attrib>
        <attrib id="renderer">
          <SparkQuadRenderer>
            <attrib id="draw in scene" value="true" />
            <attrib id="active" value="true" />
            <attrib id="effect" value="Showcase/Effects/ShowcaseParticle.fofx" />
            <attrib id="texture" value="ShowcaseSpark.tga" />
            <attrib id="scale" value="0.35;0.35" />
            <attrib id="atlas dimensions" value="1;1" />
          </SparkQuadRenderer>
        </attrib>
      </Group>
    </attrib>
  </System>
</SPARK>
