# Bounded-view fog fades inward and remains opaque outside the inclusive hex boundary

[Effect]
DepthWrite = False

[VertexShader]
layout(set = 0, binding = 0, std140) uniform ProjBuf { mat4 ProjMatrix; };

layout(location = 0) in vec3 InPosition;
layout(location = 1) in vec4 InColor;
layout(location = 2) in vec2 InTexCoord;
layout(location = 3) in vec2 InTexEggCoord;

layout(location = 0) out float Radius;

void main(void)
{
    gl_Position = ProjMatrix * vec4(InPosition.xy, 0.0, 1.0);
    Radius = InColor.r;
}

[FragmentShader]
layout(location = 0) in float Radius;
layout(location = 0) out vec4 FragColor;

void main(void)
{
    float opacity = smoothstep(0.85, 1.0, Radius);
    if (opacity <= 0.0) {
        discard;
    }
    FragColor = vec4(0.0, 0.0, 0.0, opacity);
}
